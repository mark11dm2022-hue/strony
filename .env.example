# ===== Konfiguracja MiniStrony PRO =====
# Skopiuj ten plik do ".env" i uzupelnij swoje dane.

# Port serwera
PORT=3000

# --- Konto administratora (logowanie do panelu /admin) ---
# Twój e-mail i haslo do panelu administratora.
ADMIN_EMAIL=mark11dm2022@gmail.com
ADMIN_PASSWORD=zmien_to_haslo_123

# Sekret do podpisywania sesji logowania (dowolny dlugi losowy ciag)
SESSION_SECRET=wstaw-tu-dlugi-losowy-sekret-min-32-znaki

# --- Powiadomienia e-mail (SMTP) ---
# Aby otrzymywać powiadomienia o nowych rezerwacjach i wysylać potwierdzenia,
# podaj dane SMTP. Dla Gmaila uzyj "Hasla do aplikacji" (App Password),
# NIE zwyklego hasla do konta Google.
# Instrukcja: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mark11dm2022@gmail.com
SMTP_PASS=twoje_haslo_do_aplikacji

# Adres, na który mają przychodzić powiadomienia o nowych rezerwacjach
OWNER_EMAIL=mark11dm2022@gmail.com

# Publiczny adres strony (uzywany w linkach potwierdzajacych e-mail)
PUBLIC_URL=http://localhost:3000
